ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

EMBEDDING_MODEL=intfloat/multilingual-e5-large

MANUALS_DIR=./data/manuals
VECTORSTORE_DIR=./data/vectorstore
CROPS_DIR=./data/crops
AUDIT_LOG_PATH=./data/audit_log.jsonl

# Retrieval
TOP_K_DENSE=8
TOP_K_BM25=8
TOP_K_FINAL=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
RERANK_ENABLED=true

# Thresholds
AMBIGUITY_RELATIVE_MARGIN=0.85
OFF_TOPIC_SIMILARITY_THRESHOLD=0.8

MAX_IMAGES_PER_ANSWER=12

DEBUG_TIMING_LOGS=true